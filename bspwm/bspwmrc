#! /bin/sh

# 1. Iniciar sxhkd de inmediato
sxhkd &

# 2. Configuración de Monitores (BLOQUEANTE para asegurar que el sistema los reconozca antes de seguir)
xrandr --output eDP-1-1 --primary --mode 1920x1080 --rotate normal --output HDMI-0 --mode 1920x1080 --right-of eDP-1-1 --rotate normal

# 3. Asignación de espacios de trabajo (Ahora que los monitores están garantizados)
bspc monitor eDP-1-1 -d 1 2 3 4 5 6 7 8 9 0
bspc monitor HDMI-0 -d 1 2 3 4 5 6 7 8 9 0

# 4. Lanzar Polybar (Con un pequeño delay opcional para asegurar el renderizado)
(sleep 1 && ~/.config/polybar/shapes/launch.sh) &

# 5. Resto de utilidades
nitrogen --restore &
picom -f &
wmname LG3D &

# Asignación de espacios de trabajo a monitores específicos
bspc monitor eDP-1-1 -d 1 2 3 4 5 6 7 8 9 0
bspc monitor HDMI-0 -d 1 2 3 4 5 6 7 8 9 0

bspc config border_width         1
bspc config window_gap           5
bspc config top_padding	        26

bspc config normal_border_color "#263238"
bspc config active_border_color "#546E7A"
bspc config focused_border_color "#607D8B"
bspc config presel_feedback_color "#37474F"

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
xsetroot -cursor_name left_ptr &
bspc config focus_follows_pointer true
